DISCORD_TOKEN=your_discord_bot_token_here
PYTHON_SERVICE_URL=http://127.0.0.1:8000
VOICE_BOT_PREFIX=!
VOICE_TEMP_DIR=.runtime
VOICE_ENERGY_THRESHOLD=225
VOICE_SILENCE_FRAMES=18
VOICE_MIN_SPEECH_MS=350
VOICE_MAX_SPEECH_SECONDS=8
RUST_LOG=info

PYTHON_HOST=127.0.0.1
PYTHON_PORT=8000
FASTER_WHISPER_MODEL=base.en
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
# --- Reply backend -----------------------------------------------------------
# "talos" routes replies to the TALOS brain over HTTP (POST /chat); "grok" uses
# the hosted xAI/OpenAI-Responses client configured below.
LLM_PROVIDER=talos

# TALOS text agent (used when LLM_PROVIDER=talos). This is the same always-on
# HTTP agent the TALOS GUI and voice worker talk to. When the Discord bot runs
# on a different host than the brain, point TALOS_TEXT_AGENT_URL at it.
TALOS_TEXT_AGENT_URL=http://127.0.0.1:8420
TALOS_TEXT_AGENT_TOKEN=
TALOS_SOURCE=discord
TALOS_MODE=auto
TALOS_TIMEOUT_SECONDS=30

# --- Grok / hosted LLM (used only when LLM_PROVIDER is not "talos") -----------
XAI_API_KEY=your_xai_api_key
XAI_MODEL=grok-4-1-fast-reasoning
XAI_BASE_URL=https://api.x.ai/v1
XAI_TIMEOUT_SECONDS=20
XAI_MAX_OUTPUT_TOKENS=180
MAX_HISTORY_MESSAGES=24
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
POLLY_VOICE_ID=Brian
POLLY_ENGINE=neural
