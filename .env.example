DISCORD_TOKEN=your_discord_bot_token_here
PYTHON_SERVICE_URL=http://127.0.0.1:8000
VOICE_BOT_PREFIX=!
VOICE_TEMP_DIR=.runtime
VOICE_ENERGY_THRESHOLD=225
VOICE_SILENCE_FRAMES=18
VOICE_MIN_SPEECH_MS=350
VOICE_MAX_SPEECH_SECONDS=8
RUST_LOG=info
# Stream replies sentence-by-sentence for lower latency (needs TTS_AUDIO_FORMAT=pcm
# on the Python service). Set to 0 for the legacy one-shot request/response.
VOICE_STREAMING=1

PYTHON_HOST=127.0.0.1
PYTHON_PORT=8000
FASTER_WHISPER_MODEL=base.en
# Run STT on the GPU. int8_float16 is the fastest/lowest-VRAM combo, but some
# GPUs lack the int8 GEMM path (CUBLAS_STATUS_NOT_SUPPORTED) — use float16 there.
# The service warms the model up at startup and auto-falls-back
# int8_float16 -> float16 -> int8 -> CPU, so an unsupported value won't 500.
# Use device=cpu + compute_type=int8 if no GPU is available.
FASTER_WHISPER_DEVICE=cuda
FASTER_WHISPER_COMPUTE_TYPE=float16
# Fall back to CPU (int8) if no CUDA device is visible at startup; set 0 to
# hard-require the GPU.
FASTER_WHISPER_FALLBACK_CPU=1
# --- Reply backend -----------------------------------------------------------
# "talos" routes replies to the TALOS brain over HTTP (POST /chat); "grok" uses
# the hosted xAI/OpenAI-Responses client configured below.
LLM_PROVIDER=talos

# TALOS text agent (used when LLM_PROVIDER=talos). This is the same always-on
# HTTP agent the TALOS GUI and voice worker talk to. When the Discord bot runs
# on a different host than the brain, point TALOS_TEXT_AGENT_URL at it.
TALOS_TEXT_AGENT_URL=http://127.0.0.1:8420
TALOS_TEXT_AGENT_TOKEN=
TALOS_SOURCE=discord
TALOS_MODE=auto
TALOS_TIMEOUT_SECONDS=30
# Token-streaming SSE endpoint (relative to TALOS_TEXT_AGENT_URL) used when
# VOICE_STREAMING=1. Mirrors talos/text/service_client.py:stream_message.
TALOS_STREAM_PATH=/chat/stream

# --- Grok / hosted LLM (used only when LLM_PROVIDER is not "talos") -----------
XAI_API_KEY=your_xai_api_key
XAI_MODEL=grok-4-1-fast-reasoning
XAI_BASE_URL=https://api.x.ai/v1
XAI_TIMEOUT_SECONDS=20
XAI_MAX_OUTPUT_TOKENS=180
MAX_HISTORY_MESSAGES=24
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
POLLY_VOICE_ID=Brian
POLLY_ENGINE=neural
# TTS transport: "pcm" returns raw 16-bit signed LE mono PCM (skips the MP3
# encode/decode round-trip). Polly caps pcm at 16000 Hz. Use "mp3" for the old
# behavior.
TTS_AUDIO_FORMAT=pcm
POLLY_PCM_SAMPLE_RATE=16000
